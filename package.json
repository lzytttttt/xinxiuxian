{
  "name": "xiuxian",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "中文网页修仙人生模拟器",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "typecheck:engine": "tsc -p tsconfig.engine.json",
    "test": "vitest run",
    "test:engine": "vitest run --project engine",
    "test:ui": "vitest run --project ui",
    "coverage": "vitest run --project engine --coverage",
    "lint": "eslint src/ --max-warnings 0",
    "sim": "tsx tools/sim.ts",
    "sim:golden": "tsx tools/sim.ts --golden",
    "sim:golden:write": "tsx tools/sim.ts --golden --write",
    "sim:calibrate": "tsx tools/sim.ts --calibrate",
    "sim:calibrate:write": "tsx tools/sim.ts --calibrate --write",
    "sim:pacing": "tsx tools/sim.ts --pacing",
    "sim:replay": "tsx tools/sim.ts --replay",
    "content:names": "tsx tools/gen-names.ts",
    "content:names:check": "tsx tools/gen-names.ts --check",
    "content:validate": "tsx tools/validate-content.ts",
    "content:stats": "tsx tools/validate-content.ts --stats",
    "verify": "npm run typecheck && npm run lint && npm test && npm run content:names:check && npm run content:validate && npm run sim:golden"
  },
  "dependencies": {
    "immer": "^11.1.18",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
